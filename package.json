{
  "name": "@latchprotocol/sdk",
  "version": "0.1.0",
  "description": "MIT TypeScript SDK for LatchProtocol — deployed contract addresses, pool key/id derivation, hook permission bitmaps, typed events, and the Latch registry. Build hooks without importing GPL Solidity.",
  "license": "MIT",
  "homepage": "https://latch.guru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Latch-Protocol-Team/latch-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Latch-Protocol-Team/latch-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js",
      "default": "./dist/events/index.js"
    },
    "./indexer": {
      "types": "./dist/indexer/index.d.ts",
      "import": "./dist/indexer/index.js",
      "default": "./dist/indexer/index.js"
    },
    "./deployments": {
      "types": "./dist/deployments/index.d.ts",
      "import": "./dist/deployments/index.js",
      "default": "./dist/deployments/index.js"
    },
    "./safe": {
      "types": "./dist/safe/index.d.ts",
      "import": "./dist/safe/index.js",
      "default": "./dist/safe/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js",
      "default": "./dist/registry/index.js"
    },
    "./launchpad": {
      "types": "./dist/launchpad/index.d.ts",
      "import": "./dist/launchpad/index.js",
      "default": "./dist/launchpad/index.js"
    },
    "./split": {
      "types": "./dist/split/index.d.ts",
      "import": "./dist/split/index.js",
      "default": "./dist/split/index.js"
    },
    "./lock": {
      "types": "./dist/lock/index.d.ts",
      "import": "./dist/lock/index.js",
      "default": "./dist/lock/index.js"
    },
    "./price": {
      "types": "./dist/price/index.d.ts",
      "import": "./dist/price/index.js",
      "default": "./dist/price/index.js"
    },
    "./trust": {
      "types": "./dist/trust/index.d.ts",
      "import": "./dist/trust/index.js",
      "default": "./dist/trust/index.js"
    },
    "./drop": {
      "types": "./dist/drop/index.d.ts",
      "import": "./dist/drop/index.js",
      "default": "./dist/drop/index.js"
    },
    "./trading": {
      "types": "./dist/trading/index.d.ts",
      "import": "./dist/trading/index.js",
      "default": "./dist/trading/index.js"
    },
    "./schema.graphql": "./schema.graphql",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema.graphql",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:ci": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "npm run build"
  },
  "keywords": [
    "latchprotocol",
    "amm",
    "hooks",
    "defi",
    "ethereum",
    "sdk",
    "typescript",
    "viem",
    "concentrated-liquidity",
    "dex",
    "launchpad",
    "robinhood-chain"
  ],
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "blockstore-core": "^7.0.1",
    "ipfs-unixfs-importer": "^17.1.1",
    "multiformats": "^14.0.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
